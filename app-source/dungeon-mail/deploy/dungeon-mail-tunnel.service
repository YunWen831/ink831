[Unit]
Description=Dungeon Mail public development tunnel
After=network-online.target dungeon-mail-test.service
Wants=network-online.target dungeon-mail-test.service

[Service]
Type=simple
User=rocky
Group=rocky
WorkingDirectory=/home/rocky/dungeon-mail-test/app/app-source/dungeon-mail
ExecStart=/usr/bin/python3 -u tunnel.py
Restart=always
RestartSec=8
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rocky/dungeon-mail-test/run
MemoryMax=256M
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
